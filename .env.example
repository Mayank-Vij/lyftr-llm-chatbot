# ---- Backend ----
# Comma-separated key pool (>= 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=gsk_your_real_first_key,gsk_your_real_second_key
LLM_MODEL=groq/openai/gpt-oss-120b
# SQLite location (inside the Docker volume mounted at /data)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header (required on the deployed backend for grading)
ENABLE_FAILURE_SIMULATION=true

# Optional
# LLM_API_BASE=            # custom OpenAI-compatible endpoint
# LLM_TIMEOUT_SECONDS=30
# MAX_HISTORY_MESSAGES=50  # newest N stored messages sent to the model
# KEY_COOLDOWN_SECONDS=30  # skip a key that just failed for this long
# DEFAULT_SYSTEM_PROMPT=
# LITELLM_CACHE_DIR=       # defaults to <dir of DATABASE_URL>/litellm_cache

# ---- Frontend (build time) ----
# Public URL of the backend as seen from the browser
VITE_API_URL=http://localhost:8000
